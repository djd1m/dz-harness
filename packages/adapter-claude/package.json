{
  "name": "@dzhechkov/adapter-claude",
  "version": "0.2.7",
  "description": "Claude Code platform adapter - compiles canonical skills into the .claude/skills tree.",
  "type": "module",
  "license": "MIT",
  "author": "dzhechko",
  "keywords": [
    "agent-skills",
    "claude-code",
    "adapter",
    "harness"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    ".dz-manifest.json",
    "sbom.json"
  ],
  "scripts": {
    "prepublishOnly": "node ../../../scripts/prepublish-gate.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dzhechkov/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djd1m/dz-harness.git",
    "directory": "packages/@dzhechkov/adapter-claude"
  },
  "homepage": "https://github.com/djd1m/dz-harness/tree/main/packages/@dzhechkov/adapter-claude#readme",
  "bugs": {
    "url": "https://github.com/djd1m/dz-harness/issues"
  }
}

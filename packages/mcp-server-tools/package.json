{
  "name": "@dzhechkov/mcp-server-tools",
  "version": "0.2.10",
  "description": "MCP server exposing DZ harness operations (skill list/get/compile, harness verify) over stdio.",
  "type": "module",
  "license": "MIT",
  "author": "dzhechko",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "harness"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dz-mcp-server-tools": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    ".dz-manifest.json",
    "sbom.json"
  ],
  "scripts": {
    "prepublishOnly": "node ../../../scripts/prepublish-gate.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dzhechkov/adapter-agents-md": "workspace:*",
    "@dzhechkov/adapter-claude": "workspace:*",
    "@dzhechkov/adapter-codex": "workspace:*",
    "@dzhechkov/adapter-copilot": "workspace:*",
    "@dzhechkov/adapter-cursor": "workspace:*",
    "@dzhechkov/adapter-gemini": "workspace:*",
    "@dzhechkov/adapter-openclaude": "workspace:*",
    "@dzhechkov/adapter-hermes": "workspace:*",
    "@dzhechkov/adapter-opencode": "workspace:*",
    "@dzhechkov/adapter-windsurf": "workspace:*",
    "@dzhechkov/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.0.0",
    "zod": "^4.4.3",
    "@dzhechkov/harness-core": "workspace:*",
    "@dzhechkov/harness-presets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djd1m/dz-harness.git",
    "directory": "packages/@dzhechkov/mcp-server-tools"
  },
  "homepage": "https://github.com/djd1m/dz-harness/tree/main/packages/@dzhechkov/mcp-server-tools#readme",
  "bugs": {
    "url": "https://github.com/djd1m/dz-harness/issues"
  }
}

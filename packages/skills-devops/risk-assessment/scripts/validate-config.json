{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "risk-assessment config validator",
  "description": "Validates configuration inputs for the risk-assessment skill",
  "type": "object",
  "properties": {
    "diff": {
      "type": "string",
      "description": "Git diff content to analyze"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1,
      "description": "PR number to analyze"
    },
    "commit_range": {
      "type": "string",
      "description": "Git commit range to analyze (e.g., 'main..HEAD')"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["security", "performance", "reliability", "compliance"]
      },
      "default": ["security", "performance", "reliability", "compliance"],
      "description": "Risk categories to evaluate"
    },
    "threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25,
      "default": 10,
      "description": "Risk score threshold for pass/warn boundary"
    },
    "block_threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25,
      "default": 16,
      "description": "Risk score threshold for warn/block boundary"
    },
    "scan_secrets": {
      "type": "boolean",
      "default": true,
      "description": "Enable secret leak detection"
    },
    "scan_dependencies": {
      "type": "boolean",
      "default": true,
      "description": "Enable dependency vulnerability scanning"
    },
    "check_breaking_changes": {
      "type": "boolean",
      "default": true,
      "description": "Enable breaking change detection"
    }
  },
  "anyOf": [
    { "required": ["diff"] },
    { "required": ["pr_number"] },
    { "required": ["commit_range"] }
  ]
}

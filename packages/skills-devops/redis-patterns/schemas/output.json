{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "redis-patterns output",
  "description": "Structured output from the redis-patterns skill",
  "type": "object",
  "required": ["status", "summary", "action_type"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "error", "needs_more_info"]
    },
    "summary": {
      "type": "string",
      "description": "One-line summary of the Redis pattern design or review"
    },
    "action_type": {
      "type": "string",
      "enum": ["design", "review", "implement", "optimize", "monitor"],
      "description": "What type of action was performed"
    },
    "patterns_used": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "data_structure"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Pattern name (e.g., cache-aside, sliding-window-rate-limit)"
          },
          "data_structure": {
            "type": "string",
            "enum": ["string", "hash", "list", "set", "sorted_set", "stream", "hyperloglog", "bitmap"],
            "description": "Redis data structure used"
          },
          "ttl_seconds": {
            "type": "integer",
            "description": "TTL applied to keys in this pattern"
          },
          "has_jitter": {
            "type": "boolean",
            "description": "Whether TTL jitter is applied"
          }
        }
      },
      "description": "Redis patterns implemented or recommended"
    },
    "caching_strategy": {
      "type": "string",
      "enum": ["cache-aside", "write-through", "write-behind", "read-through", "none"],
      "description": "Primary caching strategy if applicable"
    },
    "review_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "finding", "recommendation"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "warning", "info"]
          },
          "finding": { "type": "string" },
          "recommendation": { "type": "string" },
          "anti_pattern": { "type": "string" }
        }
      },
      "description": "Review findings when auditing existing Redis usage"
    },
    "self_check": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "total": {
          "type": "integer",
          "const": 10
        },
        "failures": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "description": "Results of the 10-item self-check"
    },
    "files_generated": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of files created or modified"
    }
  }
}

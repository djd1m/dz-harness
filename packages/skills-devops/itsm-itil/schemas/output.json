{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "itsm-itil ticket manifest",
  "description": "Structured view of an ITSM ticket (or a ranked backlog entry) managed by the itsm-itil skill.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "state", "title"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "enum": ["incident", "problem", "change"] },
    "state": {
      "type": "string",
      "enum": ["open", "mitigated", "resolved", "known-error", "verifying", "parked", "proposed", "approved", "released", "rejected", "closed"]
    },
    "title": { "type": "string" },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "incidents": { "type": "array", "items": { "type": "integer" }, "description": "for problems: linked incident ids" },
    "problem": { "type": ["integer", "null"], "description": "linked problem id (incidents/changes)" },
    "change": { "type": ["integer", "null"], "description": "corrective RFC id (problems)" },
    "workaround": { "type": "string", "description": "required when state = known-error" },
    "wsjf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "time", "risk", "size"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "time": { "type": "number", "minimum": 0 },
        "risk": { "type": "number", "minimum": 0 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "score": { "type": "number", "description": "(value+time+risk)/size; 0 for verifying/parked" }
      }
    }
  }
}

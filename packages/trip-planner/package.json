    "bin/",
    "src/",
    "templates/",
    "test/",
    "README.md",
    "LICENSE",
    ".dz-manifest.json",
    "sbom.json"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "trip-planner",
    "travel",
    "itinerary",
    "trip-advisor",
    "yandex-maps",
    "open-meteo",
    "weather",
    "mobile",
    "site-generator",
    "skill-pack",
    "npx-toolkit"
  ],
  "author": "dzhechko",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../../scripts/prepublish-gate.mjs",
    "test": "node --test test/init.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djd1m/dz-harness.git",
    "directory": "packages/@dzhechkov/trip-planner"
  },

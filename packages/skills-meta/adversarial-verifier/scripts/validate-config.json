{
  "schema": "../schemas/output.json",
  "rules": [
    {
      "id": "AV-001",
      "description": "Verdict must be one of the five taxonomy values",
      "path": "verdict",
      "condition": "exists",
      "severity": "error"
    },
    {
      "id": "AV-002",
      "description": "Every verdict must carry a 1-10 confidence",
      "path": "confidence",
      "condition": "exists",
      "severity": "error"
    },
    {
      "id": "AV-003",
      "description": "A TRUE_POSITIVE below the confidence floor (7) must be downgraded to UNCONFIRMED",
      "path": "confidence",
      "condition": ">=",
      "value": 7,
      "severity": "warning"
    },
    {
      "id": "AV-004",
      "description": "Finding must be restated as a falsifiable claim before verification",
      "path": "finding",
      "condition": "exists",
      "severity": "error"
    }
  ]
}

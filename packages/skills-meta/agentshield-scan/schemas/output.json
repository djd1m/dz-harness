{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentShield Scan Output",
  "type": "object",
  "required": ["grade", "score", "recommendation"],
  "properties": {
    "grade": { "type": "string", "enum": ["A", "B", "C", "D", "F"] },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "findings_count": {
      "type": "object",
      "properties": {
        "critical": { "type": "integer" },
        "high": { "type": "integer" },
        "medium": { "type": "integer" },
        "low": { "type": "integer" },
        "info": { "type": "integer" }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "critical_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "fix": { "type": "string" }
        }
      }
    },
    "recommendation": { "type": "string", "enum": ["pass", "fix-and-rescan", "block"] }
  }
}

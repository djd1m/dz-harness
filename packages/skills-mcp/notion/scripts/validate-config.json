{
  "name": "notion",
  "version": "1.0.0",
  "validators": [
    {
      "id": "env-check",
      "type": "env",
      "description": "Verify NOTION_API_KEY is set",
      "required_vars": ["NOTION_API_KEY"],
      "error_message": "NOTION_API_KEY is required. Create an integration at https://www.notion.so/my-integrations"
    },
    {
      "id": "mcp-server-check",
      "type": "command",
      "description": "Verify MCP server package is available",
      "command": "npx --yes @notionhq/notion-mcp-server --version",
      "timeout_ms": 30000,
      "error_message": "Cannot locate @notionhq/notion-mcp-server. Run: npm install -g @notionhq/notion-mcp-server"
    },
    {
      "id": "api-key-format",
      "type": "pattern",
      "description": "Validate API key format (starts with ntn_)",
      "var": "NOTION_API_KEY",
      "pattern": "^ntn_[a-zA-Z0-9]{40,}$",
      "error_message": "NOTION_API_KEY does not match expected format (should start with ntn_)"
    },
    {
      "id": "output-schema",
      "type": "json-schema",
      "description": "Validate tool output against schema",
      "schema_path": "../schemas/output.json"
    }
  ],
  "mcp_config": {
    "server_name": "notion",
    "command": "npx",
    "args": ["@notionhq/notion-mcp-server"],
    "transport": "stdio",
    "env": {
      "NOTION_API_KEY": "${NOTION_API_KEY}"
    }
  }
}

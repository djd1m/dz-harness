{
  "name": "@dzhechkov/harness-cli",
  "version": "0.8.40",
  "description": "The dz CLI — install AI skills for Claude Code, Codex, OpenCode, Hermes, OpenClaude, GitHub Copilot. 87 commands, 14 presets, 10 platform targets.",
  "type": "module",
  "license": "MIT",
  "author": "dzhechko",
  "keywords": [
    "agent-skills",
    "agentskills.io",
    "harness",
    "cli",
    "claude-code",
    "codex",
    "opencode",
    "hermes",
    "ai-skills",
    "cross-platform",
    "openclaude",
    "agentdb",
    "self-learning",
    "mcp"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dz": "./dist/bin.js"
  },
  "files": [
    ".dz-manifest.json",
    "LICENSE",
    "README.md",
    "dist",
    "keys",
    "sbom.json",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dzhechkov/harness-core": "^0.8.48",
    "@dzhechkov/harness-presets": "^0.5.24",
    "@dzhechkov/scout": "^0.8.12",
    "@dzhechkov/skills-devops": "^0.3.18",
    "@dzhechkov/skills-mcp": "^0.3.11",
    "@dzhechkov/skills-web3": "^0.2.10",
    "@dzhechkov/skills-qe": "^0.3.15",
    "@dzhechkov/skills-meta": "^0.9.63",
    "@dzhechkov/skills-academic": "^0.3.8",
    "@dzhechkov/skills-ecc": "^0.1.13",
    "@dzhechkov/skills-news": "^0.1.17",
    "@dzhechkov/skills-pm": "^0.1.6",
    "@dzhechkov/skills-taste": "^0.1.6",
    "@dzhechkov/skills-idea2prd": "^0.1.16",
    "@dzhechkov/skills-reverse-engineering": "^0.3.5",
    "@dzhechkov/skills-presentation-storyteller": "^0.1.15",
    "@dzhechkov/skills-website-cloner": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djd1m/dz-harness.git",
    "directory": "packages/@dzhechkov/harness-cli"
  },
  "homepage": "https://aicoding.space",
  "bugs": {
    "url": "https://github.com/djd1m/dz-harness/issues"
  }
}

{
  "name": "@dzhechkov/core",
  "version": "0.2.20",
  "description": "Canonical skill + hooks schemas and the platform-adapter contract for the DZ cross-platform harness.",
  "type": "module",
  "license": "MIT",
  "author": "dzhechko",
  "keywords": [
    "agent-skills",
    "agentskills.io",
    "skill-schema",
    "claude-code",
    "harness"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest-coverage": {
      "types": "./dist/vitest.coverage.shared.d.ts",
      "import": "./dist/vitest.coverage.shared.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    ".dz-manifest.json",
    "sbom.json"
  ],
  "scripts": {
    "prepublishOnly": "node ../../../scripts/prepublish-gate.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/djd1m/dz-harness-hub.git",
    "directory": "packages/@dzhechkov/core"
  },
  "homepage": "https://github.com/djd1m/dz-harness-hub/tree/main/packages/@dzhechkov/core#readme"
}
